# Copy to .env and fill in — key NAMES only, never commit values.
# FLAGSMITH_API_KEY: Flagsmith Master API key (is_admin) for the CLI.
# GEMINI_API_KEY: optional Google AI Studio key for the LLM parsing path.
# FLAGSMITH_ENVIRONMENT_KEY: environment key from `flagsmith init`.
FLAGSMITH_API_KEY=
GEMINI_API_KEY=
FLAGSMITH_ENVIRONMENT_KEY=
